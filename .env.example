# Copy to .env and adjust paths/settings for your machine.
DATA_DIR=dataset
TRAIN_DIR=dataset/train
IMG_SIZE=224
BATCH_SIZE=64
NUM_CLASSES=4
CLASS_NAMES=D00,D10,D20,D40
SEED=42
TEST_SIZE=0.15
VAL_SIZE=0.15
HEAD_EPOCHS=100
HEAD_LR=0.001
DROPOUT=0.5
PATIENCE_EARLYSTOP=12
PATIENCE_LR=5
RESULTS_DIR=results
CHECKPOINT_PATH=results/models/vgg16_multilabel.keras
FEATURES_CACHE=results/models/vgg16_features.npz
HISTORY_PATH=results/metrics/training_history.json
